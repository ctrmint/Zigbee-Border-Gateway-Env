# Generate TWO distinct tokens with:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
# Blank tokens intentionally prevent startup until configured.
GATEWAY_TOKEN=
DASHBOARD_TOKEN=

# Simulator defaults. For hardware, set the board URL and a separate DB_PATH.
GATEWAY_URL=http://127.0.0.1:8081
SIM_PORT=8081
BIND_HOST=127.0.0.1
PORT=8080
DB_PATH=data/demo.sqlite3
